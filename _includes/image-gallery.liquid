<style>
    .image-gallery { overflow: auto; margin-left: -1% !important; }
    .image-gallery .image-gallery-item { width: 19%; float: left; margin: 0 0 1% 1%; }
    .image-gallery img { width: 100%; display: block; text-align: center; text-decoration: none !important; }
  </style>
  
  <div class="image-gallery">
  {% for file in site.static_files %}
    {% if file.path contains include.folder %}
      {% if file.extname == '.jpg' or 
        file.extname == '.jpeg' or 
        file.extname == '.JPG' or 
        file.extname == '.PNG' or 
        file.extname == '.png' or 
        file.extname == '.JPEG' %}
  
        <div class="image-gallery-item">
        <img src="{{ file.path }}" alt="{{ filename }}" data-zoomable width="100%" loading="lazy"/>
        </div>  
      {% endif %}
    {% endif %}
  {% endfor %}
  </div>